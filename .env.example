# The default director requires no key, SDK or API spend.
COLONY_DIRECTOR=local

# Optional Claude advice, at most one request every seventh simulation turn.
# Install with: python -m pip install '.[claude]'
# COLONY_DIRECTOR=claude
# COLONY_AI_INTERVAL=7
# ANTHROPIC_API_KEY=your-api-key-here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Daily email is enabled only after a sending account is connected.
COLONY_EMAIL_ENABLED=false
COLONY_EMAIL_TO=
SMTP_HOST=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=ssl
SMTP_PORT=465
# Optional existing published HTTPS dashboard; otherwise use attachments.
COLONY_DASHBOARD_URL=
